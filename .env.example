# Variable names only. Set these in your shell; never commit real values.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Optional screenshot model; also used when GROQ_MODEL is text-only GPT-OSS.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FLOWSTATE_HOTKEY=ctrl+shift+space
FLOWSTATE_CONTACTS=
FLOWSTATE_ACTIVE_FILE=
# Coding input mode: leave blank to detect tools/setup_whisper.sh's local runtime/model.
FLOWSTATE_WHISPER_BIN=
FLOWSTATE_WHISPER_MODEL=
# Input file selection defaults to Groq. Create a Groq Free-plan key at console.groq.com/keys.
FLOWSTATE_INPUT_PROVIDER=groq
# Input selection uses a text model, independently of the messaging vision model above.
# Optional override; blank defaults to openai/gpt-oss-20b on Groq or OPENAI_MODEL on OpenAI.
FLOWSTATE_INPUT_MODEL=
# Optional paid provider: used only when FLOWSTATE_INPUT_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
FLOWSTATE_INVESTIGATE_HOTKEY=ctrl+alt+space
FLOWSTATE_AGENT=
FLOWSTATE_AGENT_TIMEOUT=240
FLOWSTATE_SHOW_IN=
