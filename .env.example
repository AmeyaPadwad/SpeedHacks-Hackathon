# Variable names only. Set these in your shell or .env; never commit real values.
# Pette is SOMA's UI; run_pette_soma.sh sets PETTE_SOMA_ENDPOINT for you.
PETTE_SOMA_ENDPOINT=
FLOWSTATE_HOTKEY=ctrl+shift+space
PETTE_CAMERA_HOTKEY=ctrl+alt+c
PETTE_WORLD_HOTKEY=ctrl+alt+w
PETTE_SOMA_HOTKEY=ctrl+alt+s
PETTE_BUBBLE_HOTKEY=ctrl+alt+b
FLOWSTATE_SHOW_IN=
FLOWSTATE_DB=
# SOMA launcher (run_pette_soma.sh)
SOMA_CONFIG=configs/pette.yaml
SOMA_CHECKPOINT=
SOMA_INTERVAL=2
SOMA_SYNTHETIC=0
