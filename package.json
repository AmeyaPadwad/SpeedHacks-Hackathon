    "@tensorflow-models/hand-pose-detection": "2.0.1",
    "@tensorflow/tfjs": "4.22.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "framer-motion": "11.11.17",
    "idb": "8.0.0",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
